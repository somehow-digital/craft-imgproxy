{
	"name": "somehow-digital/craft-imgproxy",
	"description": "imgproxy integration for Craft CMS.",
	"license": "MIT",
	"type": "craft-plugin",
	"keywords": [
		"imgproxy",
		"images",
		"proxy",
		"integration",
		"plugin"
	],
	"authors": [
		{
			"name": "Thomas Deinhamer",
			"email": "code@thasmo.dev",
			"homepage": "https://thasmo.com/"
		}
	],
	"homepage": "https://somehow.digital/",
	"support": {
		"email": "support@somehow.digital",
		"issues": "https://github.com/somehow-digital/craft-imgproxy/issues",
		"source": "https://github.com/somehow-digital/craft-imgproxy",
		"docs": "https://github.com/somehow-digital/craft-imgproxy"
	},
	"require": {
		"php": "^8.2",
		"ext-ctype": "*",
		"ext-filter": "*",
		"craftcms/cms": "^5.8.0",
		"somehow-digital/imgproxy": "^1.1.1"
	},
	"require-dev": {
		"craftcms/phpstan": "dev-main",
		"deptrac/deptrac": "^4.7",
		"ergebnis/composer-normalize": "^2.56",
		"pestphp/pest": "^3.0 || ^4.0",
		"phpat/phpat": "^0.12.5",
		"phpstan/phpstan": "^2.1",
		"phpstan/phpstan-deprecation-rules": "^2.0",
		"phpstan/phpstan-strict-rules": "^2.0",
		"rector/rector": "^2.0",
		"roave/security-advisories": "dev-latest",
		"shipmonk/composer-dependency-analyser": "^1.8",
		"shipmonk/phpstan-rules": "^4.0",
		"symplify/easy-coding-standard": "^13.0",
		"tomasvotruba/cognitive-complexity": "^1.3",
		"vincentlanglet/twig-cs-fixer": "^4.1"
	},
	"conflict": {
		"yiisoft/yii2-composer": "<2.0.10"
	},
	"autoload": {
		"psr-4": {
			"SomehowDigital\\Craft\\ImgProxy\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"SomehowDigital\\Craft\\ImgProxy\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"craftcms/plugin-installer": true,
			"ergebnis/composer-normalize": true,
			"pestphp/pest-plugin": true,
			"yiisoft/yii2-composer": true
		},
		"optimize-autoloader": true,
		"sort-packages": true
	},
	"extra": {
		"handle": "imgproxy",
		"name": "imgproxy"
	},
	"scripts": {
		"check": [
			"@composer-normalize",
			"@ecs",
			"@twig",
			"@rector",
			"@phpstan",
			"@deptrac",
			"@deps",
			"@test",
			"@coverage",
			"@mutate"
		],
		"composer-normalize": "@composer normalize --dry-run --diff --no-check-lock --no-update-lock \"$(pwd)/composer.json\"",
		"composer-normalize-fix": "@composer normalize --no-check-lock --no-update-lock \"$(pwd)/composer.json\"",
		"coverage": "pest --coverage --min=100",
		"deps": "composer-dependency-analyser",
		"deptrac": [
			"deptrac analyse --no-progress",
			"deptrac debug:unassigned"
		],
		"ecs": "ecs check",
		"ecs-fix": "ecs check --fix",
		"mutate": "pest --mutate --everything --covered-only --parallel --min=100",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"rector": "rector process --dry-run",
		"rector-fix": "rector process",
		"test": "pest",
		"twig": "twig-cs-fixer lint",
		"twig-fix": "twig-cs-fixer fix"
	}
}
