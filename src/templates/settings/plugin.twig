{% import '_includes/forms.twig' as forms %}

{{ forms.autosuggestField({
	label: 'Endpoint'|t('imgproxy'),
	id: 'endpoint',
	name: 'endpoint',
	value: settings.endpoint,
	errors: settings.getErrors('endpoint'),
	suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
	label: 'Signature Key'|t('imgproxy'),
	id: 'signatureKey',
	name: 'signatureKey',
	value: settings.signatureKey,
	errors: settings.getErrors('signatureKey'),
	suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
	label: 'Signature Salt'|t('imgproxy'),
	id: 'signatureSalt',
	name: 'signatureSalt',
	value: settings.signatureSalt,
	errors: settings.getErrors('signatureSalt'),
	suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
	label: 'Fallback Format'|t('imgproxy'),
	instructions: 'The format for sources that browsers can\'t display, such as HEIC and TIFF, when a transform has no format.'|t('imgproxy'),
	id: 'fallbackFormat',
	name: 'fallbackFormat',
	value: settings.fallbackFormat,
	errors: settings.getErrors('fallbackFormat'),
	suggestions: [{label: 'Formats'|t('imgproxy'), data: [
		{name: 'jpg'}, {name: 'png'}, {name: 'webp'}, {name: 'avif'},
	]}],
	suggestEnvVars: true,
}) }}

{{ forms.booleanMenuField({
	label: 'Thumbnails'|t('imgproxy'),
	instructions: 'Whether imgproxy generates the thumbnails of the control panel, or Craft does.'|t('imgproxy'),
	id: 'thumbnails',
	name: 'thumbnails',
	value: settings.thumbnails,
	includeEnvVars: true,
	errors: settings.getErrors('thumbnails'),
}) }}
